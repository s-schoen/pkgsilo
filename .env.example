ENV=prod
HTTP_ADDR=:8080
# Address of the listener that serves GET /metrics. Empty turns metrics off.
# METRICS_ADDR=:9090
# OTLP/HTTP endpoint of the collector that receives the spans. Setting it turns tracing on; the standard
# OTEL_* variables, such as OTEL_EXPORTER_OTLP_HEADERS or OTEL_TRACES_SAMPLER, configure it further.
# The exporter appends /v1/traces to it. OTEL_EXPORTER_OTLP_TRACES_ENDPOINT takes the full URL instead.
# OTEL_SDK_DISABLED=true or OTEL_TRACES_EXPORTER=none turns tracing off despite an endpoint.
# Jaeger from `task tracing:up` receives on 4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
DATABASE_URL=postgres://pkgsilo:pkgsilo@localhost:5432/pkgsilo?sslmode=disable
# DATABASE_MAX_CONNS=10
# Secret key of the stored API key hashes, at least 32 characters. Changing it invalidates every API key.
# Generate it with: openssl rand -hex 32
API_KEY_PEPPER=
