ENV=prod
HTTP_ADDR=:8080
LOG_LEVEL=info
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
DATABASE_URL=postgres://pkgsilo:pkgsilo@localhost:5432/pkgsilo?sslmode=disable
# DATABASE_MAX_CONNS=10
# Secret key of the stored API key hashes, at least 32 characters. Changing it invalidates every API key.
# Generate it with: openssl rand -hex 32
API_KEY_PEPPER=
