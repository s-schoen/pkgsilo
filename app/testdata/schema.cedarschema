entity Group;
entity Identity in [Group];
entity APIKey { owner: Identity };
entity Policy;
action "read";
action "identity:readFields";
action "identity:create";
action "identity:update";
action "group:readFields";
action "group:create";
action "group:update";
action "apikey:readFields";
action "apikey:create";
action "policy:readFields";
action "policy:create";
action "policy:update";
action "identity:read" in ["read"] appliesTo { principal: Identity, resource: Identity, context: {} };
action "identity:delete" appliesTo { principal: Identity, resource: Identity, context: {} };
action "identity:read:username" in ["identity:readFields", "read"] appliesTo { principal: Identity, resource: Identity, context: {} };
action "identity:read:displayName" in ["identity:readFields", "read"] appliesTo { principal: Identity, resource: Identity, context: {} };
