action "group:read:updatedAt" in ["group:readFields", "read"] appliesTo { principal: Identity, resource: Group, context: {} };
action "group:create:name" in ["group:create"] appliesTo { principal: Identity, resource: Group, context: {} };
action "group:update:name" in ["group:update"] appliesTo { principal: Identity, resource: Group, context: {} };
