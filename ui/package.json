{
  "name": "pkgsilo-ui",
  "private": true,
  "type": "module",
  "imports": {
    "#.storybook/preview": "./.storybook/preview.tsx"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "fmt": "oxfmt",
    "gen:api": "orval",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale",
    "lint": "oxlint",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:fix": "oxlint --fix",
    "routes": "tsr generate",
    "storybook": "storybook dev -p 6006 --exact-port --no-open",
    "storybook:build": "storybook build -o build/storybook",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/query-db-collection": "1.5.2",
    "@tanstack/react-db": "1.0.0-rc.1.5",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.108.0",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-storybook": "10.6.7",
    "eslint-plugin-testing-library": "7.16.2",
    "jsdom": "31.0.1",
    "msw": "3.0.6",
    "msw-storybook-addon": "3.0.3",
    "orval": "8.48.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "stylelint": "18.0.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
