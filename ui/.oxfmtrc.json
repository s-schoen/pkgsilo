{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "type",
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": ["build", "dist", "node_modules", "pnpm-lock.yaml"]
}
