// Keeps the Go modules, the web UI's pnpm dependencies, the MCP SDK of the compatibility test, the
// mise.toml tools, the Dockerfiles' base images and tool versions, and the GitHub Actions up to
// date. A tool that the root Dockerfile builds with moves in one pull request with its pin in
// mise.toml or go.mod. Pull requests for vulnerable dependencies are opened at once; everything
// else waits for the weekly schedule and for its release to be 3 days old. Minor and patch updates
// of 1.0+ dependencies are merged by Renovate once CI is green.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    // Reads the `# renovate:` comments above the root Dockerfile's *_VERSION ARGs.
    "customManagers:dockerfileVersions"
  ],
  // Not docker-compose: postgres:18-alpine is also pinned in test/databasetest, and a major upgrade
  // breaks existing dev volumes, so it's raised by hand.
  "enabledManagers": [
    "gomod",
    // Renovate's manager for package.json: ui/, whose pnpm-lock.yaml it updates with pnpm, and
    // app/testdata/mcpcompat, whose package-lock.json it updates with npm.
    "npm",
    "mise",
    // The base images of the root Dockerfile and of app/testdata/mcpcompat's.
    "dockerfile",
    // The customManagers:dockerfileVersions preset, which is off unless it's listed here.
    "custom.regex",
    "github-actions"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  // The commit-msg hook and the Commits workflow accept only Conventional Commits.
  "semanticCommits": "enabled",
  "osvVulnerabilityAlerts": true,
  // Supply-chain protection: a release must be public for 3 days before Renovate proposes it, so
  // that a hijacked release is usually yanked first. Vulnerability fixes skip the wait (the
  // vulnerabilityAlerts default). A release without a timestamp is held too, and listed on the
  // Dependency Dashboard (minimumReleaseAgeBehaviour's default since Renovate 42).
  "minimumReleaseAge": "3 days",
  // Proposes only versions past the age, never a newer pending one.
  "internalChecksFilter": "strict",
  // master has no required checks, so GitHub's auto-merge wouldn't wait for CI: Renovate merges
  // itself once every check is green.
  "platformAutomerge": false,
  // Pull requests, not branches: of the branches, only master gets test (PostgreSQL), and code
  // scanning checks only pull requests.
  "automergeType": "pr",
  // The go-mod-tidy hook fails on an untidy go.mod.
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Go modules (non-major)"
    },
    {
      // The modules are released together and must move together.
      "matchPackageNames": [
        "github.com/testcontainers/testcontainers-go",
        "github.com/testcontainers/testcontainers-go/**"
      ],
      "groupName": "testcontainers-go"
    },
    {
      // The go directive is the minimum Go version for the module: raise it deliberately.
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      // The toolchain line is the Go version that mise and actions/setup-go install.
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "toolchain"
      ],
      "groupName": "Go toolchain"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "UI dependencies (non-major)"
    },
    {
      // The MCP SDK that TestMCP_Compatibility drives the endpoint with isn't part of the UI. A new
      // SDK may need the test to follow it, so it gets its own pull request, which doesn't hold
      // up the UI's.
      "matchFileNames": [
        "app/testdata/mcpcompat/**"
      ],
      "groupName": "MCP SDK"
    },
    {
      // A major update of React needs the types of the same major.
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React (major)"
    },
    {
      // A major update of Vite may need a new major of its React plugin.
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "vite",
        "@vitejs/**"
      ],
      "groupName": "Vite (major)"
    },
    {
      // The coverage provider must have Vitest's exact version.
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "vitest",
        "@vitest/**"
      ],
      "groupName": "Vitest (major)"
    },
    {
      // Storybook's packages are released together, and the addons and the ESLint plugin require
      // Storybook's exact version.
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "storybook",
        "@storybook/**",
        "eslint-plugin-storybook"
      ],
      "groupName": "Storybook (major)"
    },
    {
      // oxlint declares the oxlint-tsgolint versions it runs with as a peer range.
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "oxlint",
        "oxlint-tsgolint"
      ],
      "groupName": "oxlint"
    },
    {
      // One pull request per tool, since a new mockery or golangci-lint may need regenerated
      // mocks or lint fixes before it can be merged.
      "matchManagers": [
        "mise"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      // Node and Go build the image, Debian and distroless run it.
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Docker base images (non-major)"
    },
    // The root Dockerfile builds with the versions of the development tools, so each of its copies
    // joins the pull request of the original, majors included, and the image never builds with other
    // versions than CI. These rules override the groups above, so they must come after them.
    // mcpcompat's Node is deliberately older and stays out.
    {
      "matchFileNames": [
        "mise.toml",
        "Dockerfile"
      ],
      "matchDepNames": [
        "node"
      ],
      "groupName": "Node",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchFileNames": [
        "mise.toml",
        "Dockerfile"
      ],
      "matchDepNames": [
        "pnpm"
      ],
      "groupName": "pnpm",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchFileNames": [
        "mise.toml",
        "Dockerfile"
      ],
      "matchDepNames": [
        "gomigrate"
      ],
      "groupName": "golang-migrate",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      // Joins the toolchain line of go.mod, grouped above.
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchDepNames": [
        "golang"
      ],
      "groupName": "Go toolchain",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      // The actions are pinned to the digest of an exact version tag, so a digest update means
      // the tag was moved, as in a hijacked action. github-tags ages it by the commit date, so it
      // passes minimumReleaseAge at once: it gets its own pull request and is never automerged.
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ The pinned tag now points to a different commit. Check that the move was intended before merging."
      ]
    },
    {
      // Pre-1.0 minors may break (SemVer), so they wait for review like majors. A group is
      // merged only when all of its updates are. Go versions start with a v.
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    }
  ]
}
